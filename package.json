{
  "name": "bookend",
  "version": "0.1.0",
  "private": true,
  "description": "Merge your reading history from paper books, Libby, Audible and Spotify into one log, then turn it into shareable recaps.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "try-import": "vite-node scripts/try-import.ts",
    "check:public": "node scripts/check-public-files.mjs --ref HEAD"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@zxing/browser": "^0.1.5",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-node": "^2.1.8",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
